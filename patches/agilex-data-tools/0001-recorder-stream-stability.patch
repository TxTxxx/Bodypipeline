+    bool waitForStableStreams(double timeoutSeconds=8.0){
+        const auto deadline = std::chrono::steady_clock::now() + std::chrono::duration<double>(timeoutSeconds);
+        while(std::chrono::steady_clock::now() < deadline){
+            bool ready = true;
+            for(int i=0; i<cameraColorNames.size() && ready; i++){
+                std::lock_guard<std::mutex> lock(cameraColorMsgCountMtxs.at(i));
+                if(cameraColorMsgCounts.at(i) == 0 || cameraColorWarmupStableGaps.at(i) < 15)
+                    ready = false;
+            }
+            for(int i=0; i<armJointStateNames.size() && ready; i++){
+                const bool optionalTopic = std::find(
+                    optionalArmJointStateTopics.begin(), optionalArmJointStateTopics.end(),
+                    armJointStateTopics.at(i)) != optionalArmJointStateTopics.end();
+                if(optionalTopic)
+                    continue;
+                std::lock_guard<std::mutex> lock(armJointStateMsgCountMtxs.at(i));
+                if(armJointStateMsgCounts.at(i) == 0 || armJointStateWarmupStableGaps.at(i) < 25)
+                    ready = false;
+            }
+            if(ready)
+                return true;
+            std::this_thread::sleep_for(std::chrono::milliseconds(20));
+        }
+        return false;
+    }
